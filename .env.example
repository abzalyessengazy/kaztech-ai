# ---- LLM (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...
# Fast model for ranking; stronger model for editing
MODEL_RANKER=claude-sonnet-5
MODEL_EDITOR=claude-opus-4-8

# ---- Telegram approval ----
# Create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your chat_id, for example from @userinfobot
TELEGRAM_CHAT_ID=123456789
# Channel username or id where approved posts should be published, e.g. @kaztech_ai or -1001234567890
TELEGRAM_CHANNEL_ID=
# 1 = publish approved posts to Telegram channel, 0 = skip channel
TELEGRAM_CHANNEL_ENABLED=1

# ---- LinkedIn ----
# 1 = publish approved posts to LinkedIn, 0 = skip LinkedIn
LINKEDIN_ENABLED=1
# OAuth member access token with w_member_social
LINKEDIN_ACCESS_TOKEN=
# Personal author URN: urn:li:person:XXXX
LINKEDIN_AUTHOR_URN=urn:li:person:XXXX
# Post visibility: PUBLIC or CONNECTIONS
LINKEDIN_VISIBILITY=PUBLIC
# Publishing API: rest uses /rest/posts with article metadata; ugc uses legacy /v2/ugcPosts
LINKEDIN_POST_API=rest
# LinkedIn REST API version in YYYYMM format
LINKEDIN_API_VERSION=202608
# Image mode: source downloads article og:image and uploads it to LinkedIn; none disables image upload
LINKEDIN_IMAGE_MODE=source

# ---- General ----
DB_PATH=kaztech.db
# How many candidates to rank per run
SCOUT_MAX_ITEMS=40
# Scout interval in hours
SCOUT_INTERVAL_HOURS=3
# Full newsroom cycle interval in hours. 0 means daily at 09:00 Asia/Almaty.
NEWSROOM_INTERVAL_HOURS=0
# Skip publishing if no story reaches this score
MIN_EDITORIAL_SCORE=6.5
# DRY_RUN=1 means do not publish; only write to DB and log final text
DRY_RUN=1
